  "number-sense": {
    "sourceExampleId": "number-sense-worked-example",
    "title": "Keeping the Equation Balanced",
    "workedExample": {
      "problem": "x + 5 = 12",
      "finalAnswer": "x = 7"
    },
    "steps": [
      {
        "caption": "Name the goal",
        "content": "Get x on its own on the left side.",
        "why": "An equation is solved when the variable stands alone."
      },
      {
        "caption": "Undo the +5",
        "content": "Subtract 5 from both sides: x = 12 − 5.",
        "why": "Subtracting is the opposite of adding, so it removes the +5."
      },
      {
        "caption": "Finish",
        "content": "x = 7.",
        "why": "12 − 5 is 7, and both sides are still balanced."
      }
    ],
    "hint": "What is the opposite of adding 5? Do it to BOTH sides.",
    "mindMap": [
