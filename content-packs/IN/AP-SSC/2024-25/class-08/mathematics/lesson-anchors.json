        "to": "ns-core"
      }
    ]
  },
  "inverse-operations": {
    "sourceExampleId": "inverse-operations-worked-example",
    "title": "Undoing Multiplication and Division",
    "workedExample": {
      "problem": "2x = 14",
      "finalAnswer": "x = 7"
    },
    "steps": [
      {
        "caption": "Spot the multiplier",
        "content": "The 2 is being multiplied with x.",
        "why": "To free x you need the opposite of multiplying."
      },
      {
        "caption": "Undo it",
        "content": "Divide both sides by 2: x = 14 ÷ 2.",
        "why": "Division undoes multiplication exactly."
      },
      {
        "caption": "Finish",
        "content": "x = 7.",
        "why": "14 divided by 2 is 7."
      }
    ],
    "hint": "2x means 2 × x. Which operation cancels × 2?",
    "mindMap": [
      {
        "id": "io-core",
        "label": "Inverse operations",
        "type": "current"
      },
