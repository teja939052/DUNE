  "distributive-parenthesis": {
    "sourceExampleId": "distributive-parenthesis-worked-example",
    "title": "Removing Brackets Correctly",
    "workedExample": {
      "problem": "3(x + 2) = 21",
      "finalAnswer": "x = 5"
    },
    "steps": [
      {
        "caption": "Distribute",
        "content": "3 × x and 3 × 2 gives 3x + 6, so 3x + 6 = 21.",
        "why": "The number outside brackets multiplies every term inside."
      },
      {
        "caption": "Undo the +6",
        "content": "Subtract 6 from both sides: 3x = 15.",
        "why": "Now it is a two-step equation."
      },
      {
        "caption": "Undo the ×3",
        "content": "Divide both sides by 3: x = 5.",
        "why": "Division undoes the multiplication."
      }
    ],
    "hint": "The 3 must reach BOTH x and 2. Which one is easy to forget?",
    "mindMap": [
      {
        "id": "dp-core",
        "label": "Distribute first",
        "type": "current"
      },
      {
        "id": "dp-soon",
        "label": "Two-step equations",
        "type": "target"
      }
    ],
    "mindMapEdges": [
      {
        "from": "dp-core",
        "to": "dp-soon"
      }
    ]
  },
  "two-step-equations": {
    "sourceExampleId": "two-step-equations-worked-example",
    "title": "Solving Two-Step Equations",
    "workedExample": {
      "problem": "2x + 4 = 10",
      "finalAnswer": "x = 3"
    },
    "steps": [
      {
        "caption": "Undo the +4",
        "content": "Subtract 4 from both sides: 2x = 6.",
        "why": "Removing the constant isolates the x term."
      },
      {
        "caption": "Undo the ×2",
        "content": "Divide both sides by 2: x = 3.",
        "why": "Division undoes the multiplication on x."
      },
      {
        "caption": "Check",
        "content": "2(3) + 4 = 10, so x = 3 is correct.",
        "why": "Substituting back verifies the answer."
      }
    ],
    "hint": "Two moves: first the plain number, then divide. Don't stop at 2x = 6.",
    "mindMap": [
      {
        "id": "ts-core",
        "label": "Subtract, then divide",
        "type": "current"
      },
      {
        "id": "ts-soon",
        "label": "Variables on both sides",
        "type": "target"
      }
    ],
    "mindMapEdges": [
      {
        "from": "ts-core",
        "to": "ts-soon"
      }
    ]
  },
  "variables-both-sides": {
    "sourceExampleId": "variables-both-sides-worked-example",
    "title": "Variables on Both Sides",
    "workedExample": {
      "problem": "5x - 7 = 2x + 8",
      "finalAnswer": "x = 5"
    },
    "steps": [
      {
        "caption": "Gather the x terms",
        "content": "Subtract 2x from both sides: 3x - 7 = 8.",
        "why": "One side must hold all the variables."
      },
      {
        "caption": "Gather the numbers",
        "content": "Add 7 to both sides: 3x = 15.",
        "why": "Now the x term is isolated."
      },
      {
        "caption": "Finish",
        "content": "Divide both sides by 3: x = 5.",
        "why": "Division undoes the multiplication."
      }
    ],
    "hint": "Move the 2x across first — and remember its sign flips.",
    "mindMap": [
      {
        "id": "vb-core",
        "label": "Gather like terms",
        "type": "current"
      },
