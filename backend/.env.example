PORT=3001

# MongoDB Atlas connection string (optional for the demo).
# Without this the server runs on in-memory sessions and says so in GET /api/health.
# IMPORTANT: this contains credentials. Never commit it to git.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ahapath?retryWrites=true&w=majority

# Gemini API key used by the server to generate personalised lessons.
# NEVER expose this in a VITE_ variable or commit it to git.
# Without this key the server falls back to reviewed lessons, so the app still works.
GEMINI_API_KEY=

# Optional: model and request timeout for lesson generation.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000

# Optional: short diagnostic for hackathon demos (judges leave after Q3).
# Default is 12 (full verified bank); 4 diverges weak/strong paths in ~30 seconds.
DIAGNOSTIC_COUNT=12

# Optional: override the content-packs directory (defaults to ../../content-packs).
# CONTENT_PACK_ROOT=

# Test only: base URL for live HTTP tests (integration, two-student demo).
# TEST_BASE=http://localhost:3001

# Auth needs no extra variables: demo accounts use random bearer tokens
# (no JWT secret), scrypt password hashing, and the same MONGODB_URI above
# for durable users (memory-only without it).
